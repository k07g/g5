# Local development: AWS Cognito 不要の設定例。
# `cp .env.local.example .env.local && set -a && source .env.local && set +a`
# のように読み込んでから `go run ./cmd/server` を実行してください。

PORT=8080

# インメモリ認証ベリファイアを使用(AWSアカウント不要)。本番では使用しないこと。
# g4 (https://github.com/k07g/g4) を AUTH_PROVIDER=memory で動かしている場合、
# g4 が発行するトークンはCognitoの本物のアクセストークンではないため、g5側も
# 同じく memory モードで動かす必要があります。
AUTH_PROVIDER=memory

# docker compose up -d mongo で起動したローカルDB (ホスト側ポートは27018)
MONGODB_URI=mongodb://g5:g5@localhost:27018
MONGODB_DATABASE=g5
