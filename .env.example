PORT=8080

# AWS Cognito (token verification only — g5 does not issue tokens itself;
# sign-up/sign-in is handled by https://github.com/k07g/g4, which shares
# the same Cognito user pool)
AWS_REGION=ap-northeast-1

# PostgreSQL (career sheet data, keyed by the caller's Cognito sub)
DATABASE_URL=postgres://user:password@localhost:5432/g5?sslmode=disable
