PORT=8080

# AWS Cognito (token verification only — g5 does not issue tokens itself;
# sign-up/sign-in is handled by https://github.com/k07g/g4, which shares
# the same Cognito user pool)
AWS_REGION=ap-northeast-1

# MongoDB (career sheet data, keyed by the caller's Cognito sub)
MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_DATABASE=g5
